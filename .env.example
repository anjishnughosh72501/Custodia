# All optional. Without ANTHROPIC_API_KEY the app runs on the labeled rule-based extractor.
ANTHROPIC_API_KEY=
CUSTODIA_MODEL=claude-sonnet-5-5
CUSTODIA_LLM_TIMEOUT=20
CUSTODIA_DB=custodia.db
CUSTODIA_RATE_LIMIT_PER_MIN=40
# CUSTODIA_DISABLE_LLM=1
# CUSTODIA_LOG_LEVEL=INFO
# CUSTODIA_WEB_DIR=app/web   # where the built frontend is served from
# Set CUSTODIA_RATE_LIMIT_PER_MIN=0 only for local browser / e2e tests.
#
# Note: Legacy SCOPELOCK_* environment variables are also supported as fallbacks.
