# All optional. Without ANTHROPIC_API_KEY the app runs on the labeled rule-based extractor.
ANTHROPIC_API_KEY=

# Role-based Anthropic models (default Haiku for extraction/flags, Sonnet for rewrite)
CUSTODIA_MODEL_EXTRACT=claude-haiku-5-5
CUSTODIA_MODEL_FLAGS=claude-haiku-5-5
CUSTODIA_MODEL_REWRITE=claude-sonnet-5-5
# Legacy single model fallback override:
# CUSTODIA_MODEL=claude-haiku-5-5

CUSTODIA_LLM_TIMEOUT=8
CUSTODIA_LLM_BUDGET_SECONDS=12
CUSTODIA_LLM_DAILY_CALL_CAP=500
CUSTODIA_RETENTION_DAYS=30

# Storage & Database (SQLite default; set DATABASE_URL for Neon / PostgreSQL)
CUSTODIA_DB=custodia.db
# DATABASE_URL=postgresql://user:pass@ep-xyz.neon.tech/custodia?sslmode=require

# CORS (comma-separated origins for split Vercel deployment)
# CUSTODIA_CORS_ORIGINS=https://custodia-verifier.vercel.app,http://localhost:5173

CUSTODIA_RATE_LIMIT_PER_MIN=40
# CUSTODIA_DISABLE_LLM=1
# CUSTODIA_LOG_LEVEL=INFO
# CUSTODIA_WEB_DIR=app/web   # where the built frontend is served from
# Set CUSTODIA_RATE_LIMIT_PER_MIN=0 only for local browser / e2e tests.
#
# Optional NLI (Natural Language Inference) configuration
# Set CUSTODIA_NLI_ENABLED=1 to enable semantic NLI inference
CUSTODIA_NLI_ENABLED=0
CUSTODIA_NLI_MODEL_PATH=models/model_int8.onnx
CUSTODIA_NLI_TOKENIZER_PATH=models/tokenizer.json
CUSTODIA_NLI_CONFIG_PATH=models/config.json
CUSTODIA_NLI_MAX_LENGTH=256
CUSTODIA_NLI_MAX_INPUT_CHARS=2000
CUSTODIA_NLI_ENTAILMENT_THRESHOLD=0.70
CUSTODIA_NLI_CONTRADICTION_THRESHOLD=0.60
#
# Note: Legacy SCOPELOCK_* environment variables are also supported as fallbacks.
