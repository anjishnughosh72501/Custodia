# GEMINI_API_KEY: Optional for model-assisted extraction.
# Leave blank for 100% deterministic rule-based verification (zero-key fallback).
GEMINI_API_KEY=

# APP_URL: The URL where this application is hosted.
APP_URL=

# NLI Semantic Diagnostic Module (Advisory only; deterministic engine retains authority)
# CUSTODIA_NLI_ENABLED: Set to 1 to enable local CPU inference via ONNX Runtime
CUSTODIA_NLI_ENABLED=0
# CUSTODIA_NLI_MODEL_ID: "cross-encoder/nli-MiniLM2-L6-H768" or "cross-encoder/nli-deberta-v3-xsmall"
CUSTODIA_NLI_MODEL_ID=cross-encoder/nli-MiniLM2-L6-H768
CUSTODIA_NLI_MODEL_PATH=models/model_int8.onnx
CUSTODIA_NLI_TOKENIZER_PATH=models/tokenizer.json
CUSTODIA_NLI_CONFIG_PATH=models/config.json
# CUSTODIA_NLI_ID_MAP_PATH: Token lookup table (required when using pruned cross-encoder/nli-deberta-v3-xsmall)
CUSTODIA_NLI_ID_MAP_PATH=
CUSTODIA_NLI_ENTAILMENT_THRESHOLD=0.70
CUSTODIA_NLI_CONTRADICTION_THRESHOLD=0.60
CUSTODIA_NLI_MAX_LENGTH=256
